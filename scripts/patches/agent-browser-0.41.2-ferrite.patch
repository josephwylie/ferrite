+                // Authentication must not even wait for the command state lock.
+                let _held = state.lock().await;
+                let activity = Arc::new(IdleActivity::new());
+                tokio::time::sleep(Duration::from_millis(5)).await;
+                let close = Arc::new(CloseHandshake::default());
+                let (mut client, server) = tokio::io::duplex(4096);
+                let task = tokio::spawn(handle_connection(
+                    server,
+                    state.clone(),
+                    activity.clone(),
+                    close.clone(),
+                    FerriteAuth(Some(Arc::from("random-private-token"))),
+                ));
+                let mut command = serde_json::json!({"id":"auth-test", "action":action});
+                if let Some(token) = token {
+                    command["ferriteToken"] = token.into();
+                }
+                client
+                    .write_all(format!("{}\n", command).as_bytes())
+                    .await
+                    .unwrap();
+                let mut response = String::new();
+                tokio::time::timeout(
+                    Duration::from_secs(1),
+                    BufReader::new(client).read_line(&mut response),
+                )
+                .await
+                .unwrap()
+                .unwrap();
+                let response: Value = serde_json::from_str(&response).unwrap();
+                assert_eq!(response["error"], "Unauthorized");
+                assert_eq!(response["id"], "auth-test");
+                assert!(activity.elapsed() >= Duration::from_millis(5));
+                assert!(
+                    tokio::time::timeout(Duration::from_millis(1), close.requested.notified())
+                        .await
+                        .is_err()
+                );
+                task.await.unwrap();
+            }
+        }
+    }
+
+    #[tokio::test]
+    async fn ferrite_auth_is_checked_again_after_authenticated_command() {
+        let (client, server) = tokio::io::duplex(4096);
+        let state = Arc::new(tokio::sync::Mutex::new(DaemonState::new()));
+        let task = tokio::spawn(handle_connection(
+            server,
+            state.clone(),
+            Arc::new(IdleActivity::new()),
+            Arc::new(CloseHandshake::default()),
+            FerriteAuth(Some(Arc::from("random-private-token"))),
+        ));
+        let (reader, mut writer) = tokio::io::split(client);
+        let mut reader = BufReader::new(reader);
+        // Session inspection needs no browser and leaves this connection open.
+        writer.write_all(b"{\"id\":\"first\",\"action\":\"session_info\",\"ferriteToken\":\"random-private-token\"}\n").await.unwrap();
+        let mut line = String::new();
+        tokio::time::timeout(Duration::from_secs(1), reader.read_line(&mut line))
+            .await
+            .unwrap()
+            .unwrap();
+        let first: Value = serde_json::from_str(&line).unwrap();
+        assert_eq!(first["success"], true);
+        writer
+            .write_all(b"{\"id\":\"second\",\"action\":\"launch\"}\n")
+            .await
+            .unwrap();
+        line.clear();
+        tokio::time::timeout(Duration::from_secs(1), reader.read_line(&mut line))
+            .await
+            .unwrap()
+            .unwrap();
+        let second: Value = serde_json::from_str(&line).unwrap();
+        assert_eq!(second["error"], "Unauthorized");
+        task.await.unwrap();
+        assert!(state.lock().await.browser.is_none());
+    }
+
+    #[test]
+    fn ferrite_auth_requires_matching_string_on_every_command() {
+        let auth = FerriteAuth(Some(Arc::from("random-private-token")));
+        assert!(auth.accepts(&serde_json::json!({"ferriteToken":"random-private-token"})));
+        assert!(!auth.accepts(&serde_json::json!({"ferriteToken":42})));
+        assert!(!auth.accepts(&serde_json::json!({})));
+        assert!(FerriteAuth::default().accepts(&serde_json::json!({})));
+    }
