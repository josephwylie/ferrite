diff --git a/cli/src/native/ferrite_diagnostics.rs b/cli/src/native/ferrite_diagnostics.rs
new file mode 100644
index 0000000..5bef5f9
--- /dev/null
+++ b/cli/src/native/ferrite_diagnostics.rs
@@ -0,0 +1,195 @@
+//! Bounded page-session diagnostics for Ferrite's shared attached controller.
+//! Attribute at arrival, before active-tab filtering loses the source session.
+use super::cdp::types::CdpEvent;
+use serde_json::{json, Value};
+use std::collections::{HashMap, VecDeque};
+
+const MAX_PAGES: usize = 32;
+const MAX_ENTRIES: usize = 64;
+const MAX_TEXT: usize = 2048;
+
+fn text(value: &str) -> String {
+    let mut end = value.len().min(MAX_TEXT);
+    while !value.is_char_boundary(end) {
+        end -= 1;
+    }
+    value[..end].to_string()
+}
+fn field(value: &Value, key: &str) -> String {
+    text(value.get(key).and_then(Value::as_str).unwrap_or_default())
+}
+fn push(values: &mut VecDeque<Value>, value: Value) {
+    if values.len() == MAX_ENTRIES {
+        values.pop_front();
+    }
+    values.push_back(value);
+}
+
+#[derive(Default)]
+struct Bucket {
+    console: VecDeque<Value>,
+    errors: VecDeque<Value>,
+    requests: VecDeque<Request>,
+}
+struct Request {
+    session: String,
+    native_id: String,
+    value: Value,
+}
+#[derive(Default)]
+pub(super) struct Diagnostics {
+    /// Child -> parent. Never infer ownership from whichever tab is selected.
+    parents: HashMap<String, String>,
+    pages: VecDeque<(String, Bucket)>,
+    next_request: u64,
+}
+impl Diagnostics {
+    pub fn attached(&mut self, child: &str, parent: &str) {
+        if self.parents.len() < 512 && child.len() <= 256 && parent.len() <= 256 {
+            self.parents.insert(child.into(), parent.into());
+        }
+    }
+    pub fn detached(&mut self, session: &str) {
+        self.parents.remove(session);
+        // Descendants become unresolvable when any parent disappears.
+        self.pages.retain(|(page, _)| page != session);
+    }
+    pub fn owner(&self, session: &str, is_page: impl Fn(&str) -> bool) -> Option<String> {
+        let mut session = session;
+        for _ in 0..32 {
+            if is_page(session) {
+                return Some(session.into());
+            }
+            session = self.parents.get(session)?;
+        }
+        None
+    }
+    fn bucket(&mut self, page: &str) -> &mut Bucket {
+        let index = match self.pages.iter().position(|(id, _)| id == page) {
+            Some(index) => index,
+            None => {
+                if self.pages.len() == MAX_PAGES {
+                    self.pages.pop_front();
+                }
+                self.pages.push_back((page.into(), Bucket::default()));
+                self.pages.len() - 1
+            }
+        };
+        &mut self.pages[index].1
+    }
+    pub fn record(&mut self, page: &str, event: &CdpEvent) {
+        let params = &event.params;
+        match event.method.as_str() {
+            "Page.frameNavigated"
+                if event.session_id.as_deref() == Some(page)
+                    && params.pointer("/frame/parentId").is_none() =>
+            {
+                *self.bucket(page) = Bucket::default();
+            }
+            "Runtime.consoleAPICalled" => {
+                // Do not retain remote object handles, arbitrary nested objects
+                // or unbounded raw args. Text summaries are enough for diagnosis.
+                let parts: Vec<String> = params
+                    .get("args")
+                    .and_then(Value::as_array)
+                    .into_iter()
+                    .flatten()
+                    .take(8)
+                    .map(|arg| match arg.get("value") {
+                        Some(Value::String(value)) => text(value),
+                        Some(Value::Bool(value)) => value.to_string(),
+                        Some(Value::Number(value)) => value.to_string(),
+                        _ => field(arg, "description"),
+                    })
+                    .collect();
+                push(
+                    &mut self.bucket(page).console,
+                    json!({"type":field(params,"type"),"text":text(&parts.join(" "))}),
+                );
+            }
+            "Runtime.exceptionThrown" => {
+                let details = &params["exceptionDetails"];
+                let message = details
+                    .pointer("/exception/description")
+                    .and_then(Value::as_str)
+                    .or_else(|| details.get("text").and_then(Value::as_str))
+                    .unwrap_or_default();
+                push(
+                    &mut self.bucket(page).errors,
+                    json!({"text":text(message),"url":field(details,"url"),
+                    "line":details.get("lineNumber").and_then(Value::as_i64),
+                    "column":details.get("columnNumber").and_then(Value::as_i64)}),
+                );
+            }
+            "Network.requestWillBeSent" => {
+                let Some(session) = event.session_id.as_ref().filter(|s| s.len() <= 256) else {
+                    return;
+                };
+                let native_id = field(params, "requestId");
+                self.next_request += 1;
+                let value = json!({"requestId":format!("r{}",self.next_request),
+                    "url":field(&params["request"],"url"),"method":field(&params["request"],"method"),
+                    "resourceType":field(params,"type")});
+                let bucket = self.bucket(page);
+                if bucket.requests.len() == MAX_ENTRIES {
+                    bucket.requests.pop_front();
+                }
+                bucket.requests.push_back(Request {
+                    session: session.clone(),
+                    native_id,
+                    value,
+                });
+            }
+            "Network.responseReceived" => {
+                let id = params
+                    .get("requestId")
+                    .and_then(Value::as_str)
+                    .unwrap_or_default();
+                if let Some(request) = self.bucket(page).requests.iter_mut().rev().find(|request| {
+                    request.native_id == id
+                        && Some(request.session.as_str()) == event.session_id.as_deref()
+                }) {
+                    request.value["status"] =
+                        json!(params.pointer("/response/status").and_then(Value::as_f64));
+                    request.value["mimeType"] = json!(field(&params["response"], "mimeType"));
+                }
+            }
+            _ => {}
+        }
+    }
+    pub fn read(&mut self, page: &str, kind: &str, clear: bool) -> Value {
+        let bucket = self.bucket(page);
+        if clear {
+            match kind {
+                "console" => bucket.console.clear(),
+                "errors" => bucket.errors.clear(),
+                _ => bucket.requests.clear(),
+            }
+            return json!({"cleared":true});
+        }
+        let (key, values) = match kind {
+            "console" => (
+                "messages",
+                bucket.console.iter().cloned().collect::<Vec<_>>(),
+            ),
+            "errors" => ("errors", bucket.errors.iter().cloned().collect()),
+            _ => (
+                "requests",
+                bucket
+                    .requests
+                    .iter()
+                    .map(|request| request.value.clone())
+                    .collect(),
+            ),
+        };
+        json!({key:values,"limits":{"entries":MAX_ENTRIES,"textBytes":MAX_TEXT},"bounded":true})
+    }
+    pub fn detail(&mut self, page: &str, id: &str) -> Result<Value, String> {
+        self.bucket(page)
+            .requests
+            .iter()
+            .find(|request| request.value["requestId"] == id)
+            .map(|request| request.value.clone())
+            .ok_or_else(|| "Request not found in this page".into())
+    }
+}
