+/// Ferrite uses a private command transport and never exposes the dashboard stream.
+/// An explicit mode marker makes a missing credential a startup error.
+#[derive(Clone, Default)]
+struct FerriteAuth(Option<Arc<str>>);
+
+impl FerriteAuth {
+    fn from_env() -> Result<Self, String> {
+        if env::var_os("FERRITE_AGENT_BROWSER").is_none() {
+            return Ok(Self::default());
+        }
+        if env::var("FERRITE_AGENT_BROWSER").as_deref() != Ok("1") {
+            return Err("FERRITE_AGENT_BROWSER must be 1".into());
+        }
+        let token = env::var("FERRITE_AGENT_BROWSER_TOKEN")
+            .map_err(|_| "FERRITE_AGENT_BROWSER_TOKEN is required")?;
+        if token.is_empty() {
+            return Err("FERRITE_AGENT_BROWSER_TOKEN must not be empty".into());
+        }
+        Ok(Self(Some(token.into())))
+    }
+
+    fn stream_enabled(&self) -> bool {
+        self.0.is_none()
+    }
+
+    fn accepts(&self, command: &Value) -> bool {
+        use subtle::ConstantTimeEq;
+        let Some(expected) = &self.0 else {
+            return true;
+        };
+        let Some(actual) = command.get("ferriteToken").and_then(Value::as_str) else {
+            return false;
+        };
+        // The token has a fixed random length. Equality is constant-time for
+        // equal-length credentials; length itself is not secret.
+        bool::from(expected.as_bytes().ct_eq(actual.as_bytes()))
+    }
+}
