+#[cfg(test)]
+mod audit_diff_probes {
+    use super::*;
+    #[test]
+    fn audit_diff_source_preserves_python_indent_and_make_tab() {
+        let thread=ThreadId::new(1);
+        let registry=crate::select::TranscriptText::default();
+        let runs=registry.overlay_scoped(thread,"audit-diff".into(),&[],crate::rich::TextCache::default());
+        let diff=Diff {
+            path:"example.py".into(),
+            hunks:vec![ferrite_core::Hunk {old_start:1,old_lines:2,new_start:1,new_lines:2,lines:vec![" if ready:".into(),"-    return old_value".into(),"+    return new_value".into(),"+\tmake all".into()]}],
+            added:2,removed:1,
+        };
+        runs.capture_members(|| { let _=render_diff(BlockId::TURN_DIFF,&diff,&runs); });
+        let text:Vec<_>=registry.registered(thread).into_iter().map(|x|x.3).collect();
+        assert!(text.contains(&"    return new_value".to_string()) && text.contains(&"\tmake all".to_string()),"diff display/copy sources lost indentation: {:?}",text);
+    }
