+#[gpui::test]
+fn audit_oldest_of_201_blocks_remains_in_transcript(cx: &mut TestAppContext) {
+    let (core,fake)=cockpit("audit-transcript-horizon",1);
+    bind_production_keys(cx);
+    let (view,cx)=add_cockpit_window(cx,|_,cx|CockpitView::new(core,cx));
+    cx.simulate_resize(gpui::size(px(1000.),px(800.)));
+    tick(cx);
+    for index in 0..201 {
+        fake.streams.borrow()[0].send(SessionEvent::TextDelta{text:format!("Message audit-marker-{index:03}\n\n")}).unwrap();
+        fake.streams.borrow()[0].send(SessionEvent::ContentBoundary).unwrap();
+    }
+    tick(cx);
+    tick(cx);
+    view.read_with(cx,|view,_| {
+        let thread=view.panes[0].thread().unwrap();
+        let blocks=view.cockpit.thread(thread).unwrap().transcript().blocks();
+        let core_text=transcript_text(blocks);
+        let ui_text=view.selection.registered(thread).into_iter().map(|x|x.3).collect::<String>();
+        assert!(core_text.contains("audit-marker-000"),"fixture must retain first message in core");
+        assert!(ui_text.contains("audit-marker-200"),"fixture must reach final message");
+        assert!(ui_text.contains("audit-marker-000"),"oldest message missing from entire selectable transcript document: core_blocks={}, core_contains_first={}, ui_contains_first={}, ui_contains_second={}, ui_contains_last={}",blocks.len(),core_text.contains("audit-marker-000"),ui_text.contains("audit-marker-000"),ui_text.contains("audit-marker-001"),ui_text.contains("audit-marker-200"));
+    });
+}
