+#[gpui::test]
+fn audit_crashed_background_thread_notifies_operator(cx: &mut TestAppContext) {
+    let (core,fake)=cockpit("audit-crash-notice",2);
+    bind_production_keys(cx);
+    let (view,cx)=add_cockpit_window(cx,|_,cx|CockpitView::new(core,cx));
+    tick(cx);
